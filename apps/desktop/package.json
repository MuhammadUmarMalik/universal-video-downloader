{
  "name": "@umd/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop downloader for authorized public media URLs.",
  "homepage": "https://github.com/MuhammadUmarMalik/universal-video-downloader",
  "repository": {
    "type": "git",
    "url": "https://github.com/MuhammadUmarMalik/universal-video-downloader.git"
  },
  "author": {
    "name": "Universal Media Downloader",
    "email": "support@universal-media-downloader.app"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 1420\" \"wait-on http://127.0.0.1:1420 && cross-env ELECTRON_START_URL=http://127.0.0.1:1420 electron .\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "electron .",
    "package:electron": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@umd/shared-types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "com.umd.universalmediadownloader",
    "productName": "Universal Media Downloader",
    "executableName": "universal-media-downloader",
    "artifactName": "universal-media-downloader-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "src-rust/target/release/universal-media-downloader",
        "to": "universal-media-downloader"
      }
    ],
    "linux": {
      "category": "Utility",
      "maintainer": "Universal Media Downloader <support@universal-media-downloader.app>",
      "target": ["AppImage", "deb"]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
